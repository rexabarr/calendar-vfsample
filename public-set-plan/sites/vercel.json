{
  "redirects": [
    { "source": "/crew.html", "destination": "/crew", "permanent": false },
    { "source": "/getaway.html", "destination": "/getaway", "permanent": false },
    { "source": "/celebrate.html", "destination": "/celebrate", "permanent": false }
  ],
  "rewrites": [
    { "source": "/", "destination": "/live/index.html" },
    { "source": "/crew", "destination": "/live/crew.html" },
    { "source": "/getaway", "destination": "/live/getaway.html" },
    { "source": "/celebrate", "destination": "/live/celebrate.html" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [ { "key": "X-Robots-Tag", "value": "noindex" } ] }
  ]
}
